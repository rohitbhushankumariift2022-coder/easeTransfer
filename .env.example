# easeTransfer Environment Configuration
# Copy this file to .env and fill in your values

# Server Port (default: 3000)
PORT=3000

# ========== SMS PROVIDER CONFIGURATION ==========
# Choose one: 'fast2sms', 'twilio', 'msg91', 'textlocal', or 'console' (for testing)
SMS_PROVIDER=console

# ---------- Fast2SMS (FREE for India) ----------
# Sign up at: https://www.fast2sms.com/
# Get your API key from the dashboard
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ---------- Twilio ----------
# Sign up at: https://www.twilio.com/ (Free trial available)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ---------- MSG91 ----------
# Sign up at: https://msg91.com/
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id

# ========== NOTES ==========
# Fast2SMS Setup (Recommended for India - FREE):
# 1. Go to https://www.fast2sms.com/
# 2. Sign up and verify your account
# 3. Get your API key from Dev API section
# 4. Set SMS_PROVIDER=fast2sms
# 5. Set FAST2SMS_API_KEY=your_api_key
#
# For testing without SMS:
# Set SMS_PROVIDER=console
# OTP will be shown in browser toast message
